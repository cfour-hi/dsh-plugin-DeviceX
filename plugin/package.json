{
  "name": "@cfour-hi/dsh-plugin-devicex",
  "version": "1.10.0",
  "type": "module",
  "description": "Inspect every part of this device and control what can be changed (macOS + Windows).",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "host/*.js",
    "host/win/*.ps1",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "darwin",
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfour-hi/dsh-plugin-devicex.git"
  },
  "homepage": "https://github.com/cfour-hi/dsh-plugin-devicex#readme",
  "bugs": {
    "url": "https://github.com/cfour-hi/dsh-plugin-devicex/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "device",
    "system-information",
    "macos",
    "windows",
    "monitoring"
  ]
}
