{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "react"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "include": [
    "src/client/constants.js",
    "src/client/helpers.js",
    "src/client/runtime.js",
    "src/client/normalizers.js",
    "src/client/api.js",
    "types/contracts.ts",
    "src/client/jsx.js",
    "src/client/components/*.tsx",
    "src/client/hooks.js",
    "src/client/action-helpers.tsx",
    "src/client/page.tsx",
    "src/client/use-device-metrics.js"
  ]
}
