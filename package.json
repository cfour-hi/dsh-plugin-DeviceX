{
  "name": "@cfour-hi/dsh-devicex",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "description": "Inspect every part of this device and control what can be changed (macOS + Windows).",
  "icon": "plugin/icon.svg",
  "files": ["plugin"],
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml",
      "platforms": ["darwin", "win32"]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
