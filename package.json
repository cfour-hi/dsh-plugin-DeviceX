{
  "name": "@cfour-hi/dsh-devicex",
  "version": "1.3.9",
  "private": true,
  "type": "module",
  "description": "Inspect every part of this device and control what can be changed (macOS + Windows).",
  "icon": "plugin/icon.svg",
  "files": [
    "plugin"
  ],
  "exports": {
    ".": "./plugin/index.js",
    "./client": "./plugin/client.js",
    "./locale/*.json": "./plugin/locale/*.json",
    "./icon": "./plugin/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugin/cordis.patch.yml",
      "platforms": [
        "darwin",
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:check": "node scripts/build-client.mjs --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "verify": "node scripts/verify.mjs && node scripts/verify-windows.mjs && node scripts/verify-sensors.mjs && node scripts/verify-cleanup.mjs && node scripts/verify-benchmark.mjs",
    "verify:ci": "node scripts/build-client.mjs --check && npm run typecheck && npm test && node scripts/verify-build.mjs && npm run verify",
    "build:concat": "node scripts/build-client-concat.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test": "node --test",
    "typecheck:client": "tsc -p tsconfig.client.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
